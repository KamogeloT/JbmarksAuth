# JBmarks Network Monitor — Agent configuration
# Copy to .env and fill in, or export these in your shell / systemd unit.

# Backend base URL (Railway production by default)
API_BASE=https://jbmarksauth-production.up.railway.app

# Shared secret. MUST match NETWORK_AGENT_TOKEN set on the backend (Railway).
# Generate one:  openssl rand -hex 24
NETWORK_AGENT_TOKEN=

# Friendly name for this probe (shows which agent reported a node). Defaults to hostname.
AGENT_ID=

# How often to run checks, in milliseconds (default 30000 = 30s)
INTERVAL_MS=30000

# Per-check timeout in ms (default 10000)
TIMEOUT_MS=10000

# Response time above this (ms) is flagged "slow" instead of "up" (default 3000)
SLOW_THRESHOLD_MS=3000
