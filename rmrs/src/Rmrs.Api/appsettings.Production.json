{
  "ConnectionStrings": {
    "DefaultConnection": "Server=PROD-SQL-SERVER;Database=RmrsDb;User Id=RmrsAppUser;Password=REPLACE_WITH_ENV_VARIABLE;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Rmrs": "Information"
      }
    }
  },
  "Bitrix": {
    "ClientId": "REPLACE_VIA_ENVIRONMENT_VARIABLE",
    "ClientSecret": "REPLACE_VIA_ENVIRONMENT_VARIABLE"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://records.sdinmotion.co.za"
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5001",
        "Protocols": "Http1AndHttp2"
      }
    },
    "ConfigureHttpsDefaults": {
      "SslProtocols": ["Tls12", "Tls13"]
    }
  }
}
