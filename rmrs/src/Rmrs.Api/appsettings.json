{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=RmrsDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true
          }
        }
      }
    ]
  },
  "Bitrix": {
    "BaseUrl": "https://jbmarks.sdinmotion.co.za",
    "OAuthAuthorizeUrl": "https://jbmarks.sdinmotion.co.za/oauth/authorize/",
    "OAuthTokenUrl": "https://oauth.bitrix.info/oauth/token/",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackUrl": "https://records.sdinmotion.co.za/auth/bitrix/callback",
    "Scopes": "user,sonet_group,disk"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://records.sdinmotion.co.za",
      "http://localhost:4200"
    ]
  },
  "Session": {
    "IdleTimeoutMinutes": 30,
    "CookieName": ".Rmrs.Session",
    "CookieSecure": true,
    "CookieHttpOnly": true,
    "CookieSameSite": "Strict"
  },
  "ScheduledJobs": {
    "RetentionExpiryCheck": {
      "Enabled": true,
      "CronExpression": "0 2 * * *",
      "Description": "Daily check at 02:00 for records past retention date"
    },
    "OverdueLoanNotifier": {
      "Enabled": true,
      "CronExpression": "0 8 * * *",
      "Description": "Daily check at 08:00 for overdue physical record loans"
    },
    "TokenRefreshMonitor": {
      "Enabled": true,
      "IntervalMinutes": 30,
      "Description": "Pre-emptively refresh near-expiry OAuth tokens"
    },
    "DatabaseBackup": {
      "Enabled": true,
      "CronExpression": "0 1 * * *",
      "Description": "Daily database backup at 01:00"
    }
  },
  "FileUpload": {
    "MaxFileSizeBytes": 104857600,
    "AllowedExtensions": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".csv", ".jpg", ".jpeg", ".png", ".tiff", ".bmp"]
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
