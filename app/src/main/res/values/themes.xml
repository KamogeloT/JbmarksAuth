<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- Since we're using Material3 in Compose, the actual theme is defined in Theme.kt -->
    <!-- This is just for the Activity window styling -->
    <style name="Theme.JBmarks" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash Screen Theme -->
    <style name="Theme.JBmarks.NoActionBar" parent="Theme.JBmarks">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>